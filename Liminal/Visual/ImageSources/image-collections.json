{
 "version": 2,
 "updated": "2026-11-21",
 "doc": "docs/research/image-apis/collections.md",
 "defaults": {
  "minLongSide": 2000,
  "minShortSide": 1333,
  "targetLongSide": 2528,
  "maxBytes": 12000000,
  "allowedMime": [
   "image/jpeg",
   "image/png"
  ],
  "userAgent": "Liminal/1.0 (ambient audiovisual app; curated public-domain imagery)",
  "maxRequestsPerSecond": 1,
  "storeBudgetBytes": 3000000000,
  "minFreeBytes": 1000000000,
  "unseenAhead": 12,
  "ingestInterval": 4,
  "recencyWindow": 24,
  "monochromeEvery": 6,
  "candidateRefreshDays": 7,
  "hostGaps": {
   "collectionapi.metmuseum.org": 5,
   "images.metmuseum.org": 5
  },
  "defaultHostGap": 1,
  "openness": {
   "minOpenness": 0.2,
   "minKeyShare": 0.04,
   "documentPaperShare": 0.5,
   "documentEdgeDensity": 0.06,
   "maxTextCoverage": 0.06,
   "monochromeSaturation": 0.025,
   "maxFaceArea": 0.015,
   "maxFaces": 4
  }
 },
 "providers": {
  "loc": {
   "name": "Library of Congress",
   "auth": "none",
   "search": "https://www.loc.gov/collections/{collection}/?fo=json&q={query}&c={count}&sp={page}&fa=online-format:image",
   "image": "{iiifService}/full/!{target},{target}/0/default.jpg",
   "info": "{iiifService}/info.json",
   "notes": "Take iiifService from the result's image_url (https://tile.loc.gov/image-services/iiif/service:pnp:...). Skip results with no IIIF service: those only carry a 1024 px v.jpg and a TIFF master. Rights from item.rights_advisory.",
   "license": "No known restrictions on publication (rights_advisory)",
   "institution": "Library of Congress"
  },
  "nasa": {
   "name": "NASA Image and Video Library",
   "auth": "none",
   "search": "https://images-api.nasa.gov/search?q={query}&media_type=image&year_start={yearStart}&year_end={yearEnd}&page_size={count}&page={page}",
   "assets": "https://images-api.nasa.gov/asset/{nasa_id}",
   "notes": "Use ~orig when a HEAD shows it is at most maxBytes; ~large is only 1920 px, below the size gate, so an oversized original is rejected rather than replaced. Rewrite http to https. Many Hasselblad scans are square (about 4096x4096), and the 3:2 cover crop keeps 4096x2731.",
   "license": "NASA media are generally not copyrighted (US Government work); keep center, photographer and description as credit",
   "institution": "NASA"
  },
  "wikimedia": {
   "name": "Wikimedia Commons",
   "auth": "none (descriptive User-Agent required)",
   "category": "https://commons.wikimedia.org/w/api.php?action=query&format=json&generator=categorymembers&gcmtitle=Category:{category}&gcmtype=file&gcmlimit={count}&gcmcontinue={continue}&prop=imageinfo&iiprop=url|size|mime|extmetadata&iiurlwidth=2048&iiextmetadatafilter=LicenseShortName|Artist|DateTimeOriginal|ObjectName|Credit",
   "search": "https://commons.wikimedia.org/w/api.php?action=query&format=json&generator=search&gsrnamespace=6&gsrsearch={query}%20filetype:bitmap&gsrlimit={count}&gsroffset={offset}&prop=imageinfo&iiprop=url|size|mime|extmetadata&iiurlwidth=2048&iiextmetadatafilter=LicenseShortName|Artist|DateTimeOriginal|ObjectName|Credit",
   "image": "original url when the file is at most targetLongSide wide, else imageinfo.thumburl at iiurlwidth=targetLongSide (Commons serves its 3840 px step)",
   "notes": "Pause about 1 s between API calls: bursts returned errors during probing. Reject TIFF, SVG, PDF and DjVu. License from extmetadata.LicenseShortName, credit from Artist and Credit.",
   "license": "Per file; allowlist below",
   "institution": "Wikimedia Commons"
  },
  "cma": {
   "name": "Cleveland Museum of Art Open Access",
   "auth": "none",
   "search": "https://openaccess-api.clevelandart.org/api/artworks/?q={query}&type={type}&has_image=1&cc0=1&limit={count}&skip={skip}",
   "image": "images.print.url (JPEG, about 3400 px on the long side, 2-4 MB)",
   "notes": "Never use images.full (TIFF). share_license_status must be CC0.",
   "license": "CC0",
   "institution": "Cleveland Museum of Art"
  },
  "met": {
   "name": "The Metropolitan Museum of Art Open Access",
   "auth": "none",
   "search": "https://collectionapi.metmuseum.org/public/collection/v1.1/search?hasImages=true&isPublicDomain=true&q={query}&departmentId={departmentId}&limit={count}&offset={offset}",
   "object": "https://collectionapi.metmuseum.org/public/collection/v1/objects/{objectID}",
   "image": "primaryImage (original, up to 4000 px)",
   "notes": "The v1.1 isPublicDomain filter is NOT applied server-side (NOT-PD objects came back), so check isPublicDomain on every object. An Incapsula WAF blocked the API and images.metmuseum.org after about 100 requests in a burst; keep to one object per several seconds and treat 403 HTML as a temporary outage. Fallback mirror: Internet Archive collection metropolitanmuseumofart-gallery (each item has <objectID>.jpg plus a _mma.json record).",
   "license": "CC0 when isPublicDomain is true",
   "institution": "The Metropolitan Museum of Art"
  },
  "si": {
   "name": "Smithsonian Open Access",
   "auth": "api.data.gov key (env SMITHSONIAN_API_KEY); DEMO_KEY allows only 10 requests",
   "search": "https://api.si.edu/openaccess/api/v1.0/search?q={query}+AND+online_media_type:Images&api_key={key}&rows={count}&start={start}",
   "image": "content.descriptiveNonRepeating.online_media.media[0].content (ids.si.edu deliveryService, measured 2999x2263 JPEG)",
   "notes": "Optional. Skip the provider when no key is configured. Many rows have online_media null even with the media filter.",
   "license": "CC0 (metadata_usage.access)",
   "institution": "Smithsonian Institution"
  }
 },
 "licenseAllowlist": [
  "Public domain",
  "PD",
  "CC0",
